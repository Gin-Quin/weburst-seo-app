{
	"name": "weburst-seo-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"bun": "1.4.0"
	},
	"scripts": {
		"dev": "bun --bun vite dev",
		"dev:turso": "turso dev --db-file ./data/$(git branch --show-current).db",
		"build": "bun --bun vite build",
		"deploy:app": "bun run build && bun scripts/deploy.ts",
		"deploy": "bun run turso:migrate:prod && bun run clickhouse:migrate:prod && bun run deploy:app:prod",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "bun scripts/postinstall.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"migrate": "bun db:generate && bun db:push",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"turso:migrate:prod": "bun --env-file=.env.prod run db:migrate",
		"db:studio": "drizzle-kit studio",
		"sqlite": "bun scripts/sqlite.ts",
		"db:reset": "rm -rf ./drizzle/* && bun migrate && bun run scripts/createLocalAdmin.ts",
		"clickhouse:migrate": "bun scripts/clickhouse:migrate.ts",
		"clickhouse:migrate:prod": "CLICKHOUSE_DATABASE=default bun --env-file=.env.prod run clickhouse:migrate",
		"typesafe-i18n": "typesafe-i18n",
		"add:component": "bun x shadcn-svelte@latest add button"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"@internationalized/date": "^3.8.1",
		"@libsql/client": "^0.15.15",
		"@lucide/svelte": "^0.515.0",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/bun": "latest",
		"@types/node": "^22",
		"@types/sanitize-html": "^2.16.1",
		"@types/turndown": "^5.0.6",
		"bits-ui": "^2.8.6",
		"chokidar": "^4.0.3",
		"clsx": "^2.1.1",
		"daisyui": "^5.1.9",
		"drizzle-kit": "^0.31.4",
		"drizzle-orm": "^0.44.5",
		"layerchart": "2.0.0-next.27",
		"nodemon": "^3.1.10",
		"phosphor-icons-svelte": "^2.1.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^1.0.0",
		"tailwindcss": "^4.0.0",
		"tw-animate-css": "^1.3.8",
		"typescript": "^5.0.0",
		"vite": "^7.0.4"
	},
	"dependencies": {
		"@ai-sdk/google": "^4.0.51",
		"@ai-sdk/svelte": "^5.0.79",
		"@clickhouse/client": "^1.12.1",
		"@floating-ui/dom": "^1.8.0",
		"@lucia-auth/adapter-drizzle": "^1.1.0",
		"@modelcontextprotocol/server": "^2.0.0",
		"@paralleldrive/cuid2": "^2.2.2",
		"@sveltejs/adapter-cloudflare": "^7.2.3",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.7",
		"@types/nodemailer": "^7.0.1",
		"@types/papaparse": "^5.3.16",
		"ai": "^7.0.79",
		"arctic": "^3.7.0",
		"axios": "^1.12.2",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"dompurify": "^3.4.14",
		"lucia": "^3.2.2",
		"marked": "^18.0.11",
		"nanoid": "^5.1.5",
		"papaparse": "^5.5.3",
		"prosemirror-commands": "^1.7.2",
		"prosemirror-history": "^1.5.0",
		"prosemirror-inputrules": "^1.5.1",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-model": "^1.25.11",
		"prosemirror-schema-basic": "^1.2.4",
		"prosemirror-schema-list": "^1.5.1",
		"prosemirror-state": "^1.4.4",
		"prosemirror-tables": "^1.8.5",
		"prosemirror-view": "^1.42.3",
		"sanitize-html": "^2.17.7",
		"svelte-adapter-bun": "^1.0.0",
		"svelte-sonner": "^1.0.5",
		"turndown": "^7.2.4",
		"valibot": "^1.1.0",
		"xlsx": "^0.18.5",
		"zod": "^4.4.3"
	},
	"patchedDependencies": {
		"layerchart@2.0.0-next.27": "patches/layerchart@2.0.0-next.27.patch"
	}
}
